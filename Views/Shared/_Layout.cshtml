<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - Placement Dashboard</title>
  <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header class="top">
  <div class="container nav">
    <a class="brand" asp-controller="Placement" asp-action="Index"><span class="logo">P</span><span>Placement Dashboard</span></a>
    <nav>
      <a asp-controller="Placement" asp-action="Index">Dashboard</a>
      <a asp-controller="Placement" asp-action="Report" target="_blank">Report</a>
    </nav>
  </div>
</header>
<main class="container">@RenderBody()</main>
<footer class="footer">.NET Technologies · Placement Dashboard Practical</footer>
</body>
</html>
