@{ ViewData["Title"] = "Database Setup Required"; }
<section class="heading"><div><span class="eyebrow">SETUP REQUIRED</span><h1>Database connection failed</h1><p>Follow these steps to connect the dashboard to SQL Server LocalDB.</p></div></section>
<section class="panel"><h2>How to fix it</h2><ol><li>Open Visual Studio and choose <b>View → SQL Server Object Explorer</b>, or open SQL Server Management Studio.</li><li>Run <code>Database/01_CreateDatabase.sql</code>.</li><li>Then run <code>Database/02_CreateTablesAndSampleData.sql</code>.</li><li>Check the connection string in <code>appsettings.json</code>. It defaults to <code>(localdb)\MSSQLLocalDB</code>.</li><li>Restart the application and refresh this page.</li></ol><p class="error">@ViewBag.DatabaseError</p><a class="btn" asp-action="Index">Try Again</a></section>
